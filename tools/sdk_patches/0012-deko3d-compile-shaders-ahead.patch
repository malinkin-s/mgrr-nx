@@ -1029,6 +1034,83 @@ void RenderDk::RecogerCompilaciones() {
   if (fallidas) {
     REXLOG_WARN("[deko3d] {} background compilations failed (keeping the full variant)", fallidas);
   }
+  AvanzarPrecompilacion();
+}
+
+void RenderDk::Precompilar(std::span<const EntradaShader* const> shaders, bool pronto) {
+  static const bool activo = REXCVAR_GET(deko_precompilar);
+  if (!activo || shaders.empty()) {
+    return;
+  }
+  std::lock_guard<std::mutex> cerrojo(precompilar_candado_);
+  auto& cola = pronto ? precompilar_pronto_ : precompilar_resto_;
+  for (const EntradaShader* e : shaders) {
+    if (e && !e->spirv.empty()) {
+      pronto ? cola.push_front(e) : cola.push_back(e);  // the newest scene first
+    }
+  }
+}
+
+// Once per Swap: queues the variants a draw asks for first - a pixel shader as the library has it and a vertex
+// shader with every interpolator (while that one draws, the exact variant compiles on the worker) - for the next
+// shaders waiting. The worker gets at most two of them at a time, so a compile that a draw waits for (Compilar,
+// which jumps the queue) waits for one at most.
+void RenderDk::AvanzarPrecompilacion() {
+  constexpr uint32_t kEnCola = 2, kRevisadosPorSwap = 8;
+  uint32_t revisados = 0;
+  while (revisados < kRevisadosPorSwap && compilador_.Pendientes() < kEnCola) {
+    const EntradaShader* e = nullptr;
+    {
+      std::lock_guard<std::mutex> cerrojo(precompilar_candado_);
+      auto& cola = !precompilar_pronto_.empty() ? precompilar_pronto_ : precompilar_resto_;
+      if (cola.empty()) {
+        break;
+      }
+      e = cola.front();
+      cola.pop_front();
+    }
+    ++revisados;
+    precompilar_avisado_ = false;
+    InfoShader& info = InfoDe(*e);
+    // A vertex shader's specialization bit 0 is the one draws set most; try both values it can take.
+    const uint32_t especs[2] = {0, e->vertices ? (1u & info.mascara) : 0u};
+    for (uint32_t i = 0; i < (especs[1] ? 2u : 1u); ++i) {
+      const uint32_t variante = e->vertices ? kTodasLasSalidas : 0u;
+      const deko::CacheDksh::Clave clave_cache{info.huella, especs[i], variante};
+      if (cache_.Buscar(clave_cache)) {
+        ++precompilar_en_cache_;
+        continue;
+      }
+      const uint64_t h = XXH3_64bits(&clave_cache, sizeof(clave_cache));
+      if (!en_fondo_.emplace(h, true).second) {
+        continue;
+      }
+      const deko::GlslDeko g = deko::SpirvAGlsl(e->spirv, especs[i], kTodasLasSalidas);
+      if (g.glsl.empty()) {
+        continue;
+      }
+      ++precompilados_;
+      std::weak_ptr<Bandeja> bandeja = bandeja_;
+      compilador_.Encolar(e->vertices, g.glsl, [bandeja, clave_cache](deko::Compilador::Resultado r) {
+        if (const auto b = bandeja.lock()) {
+          std::lock_guard<std::mutex> cerrojo(b->candado);
+          if (r.ok) {
+            b->hechas.emplace_back(clave_cache, std::move(r.dksh));
+          } else {
+            ++b->fallidas;
+          }
+        }
+      });
+    }
+  }
+  if (!precompilar_avisado_ && revisados == 0 && compilador_.Pendientes() == 0) {
+    std::lock_guard<std::mutex> cerrojo(precompilar_candado_);
+    if (precompilar_pronto_.empty() && precompilar_resto_.empty()) {
+      precompilar_avisado_ = true;
+      REXLOG_INFO("[deko3d] shaders compiled ahead: {} so far ({} variants were already in the cache)",
+                  precompilados_, precompilar_en_cache_);
+    }
+  }
 }
 

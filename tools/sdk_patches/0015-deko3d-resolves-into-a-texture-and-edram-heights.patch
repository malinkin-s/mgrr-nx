+// The height of a target: from its pitch, as the Vulkan path (nfsmw_nativo_destinos.cpp, ObtenerDestino explains
+// why), but never past the end of the EDRAM (2048 tiles of 80x16 pixels at 32 bits, 40x16 at 64): a target cannot
+// hold more rows than fit between its base and there. MGR's 1280x720 scene targets at base 0x530 fill exactly what
+// is left; made 1280x1280 they were never the size of their 1280x720 textures, so a whole resolve always copied.
+static uint32_t AltoDestino(uint32_t base, uint32_t pitch, bool bpp64) {
+  const uint32_t alto = std::min(kAltoMaximoDestino, std::max<uint32_t>(720, (pitch + 15) & ~15u));
+  const uint32_t teselas_por_fila = (pitch + (bpp64 ? 39 : 79)) / (bpp64 ? 40 : 80);
+  const uint32_t libres = base < 2048 ? 2048 - base : 0;
+  const uint32_t filas = teselas_por_fila ? libres / teselas_por_fila * 16 : alto;
+  return filas >= 16 ? std::min(alto, filas) : alto;
+}

+// MGR resolves its two shadow cascades, each drawn at 1024x1024, into one 1024x2048 texture: the first at the
+// texture's address, the second 4 MB further, which is the start of its lower half. As textures are images keyed by
+// address, the second one made a texture nothing samples and the lower half stayed empty.
+RenderDk::Resuelta* RenderDk::ResueltaQueContiene(uint32_t base, uint32_t ancho, uint32_t alto, uint32_t formato_guest,
+                                                  uint32_t& filas) {
+  const uint32_t fila_de_teselas = ((ancho + 31) & ~31u) * 32 * 4;
+  for (auto& [b, r] : resueltas_) {
+    if (b >= base || r.imagen.ancho != ancho || r.formato_guest != formato_guest) {
+      continue;
+    }
+    switch (r.imagen.formato) {
+      case DkImageFormat_RGBA8_Unorm:
+      case DkImageFormat_R32_Float:
+      case DkImageFormat_RGB10A2_Unorm:
+      case DkImageFormat_RG16_Float:
+      case DkImageFormat_Z24S8:
+        break;
+      default:
+        continue;
+    }
+    const uint32_t offset = base - b;
+    if (offset % fila_de_teselas) {
+      continue;
+    }
+    const uint64_t desde = uint64_t(offset / fila_de_teselas) * 32;
+    if (desde + alto <= r.imagen.alto) {
+      filas = uint32_t(desde);
+      return &r;
+    }
+  }
+  return nullptr;
+}

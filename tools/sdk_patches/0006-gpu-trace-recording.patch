diff --git a/include/rex/graphics/gpu_trace.h b/include/rex/graphics/gpu_trace.h
new file mode 100644
index 0000000..5c8348e
--- /dev/null
+++ b/include/rex/graphics/gpu_trace.h
@@ -0,0 +1,52 @@
+/**
+ * @file        rex/graphics/gpu_trace.h
+ * @brief       Records what the GPU executed for a few frames, to replay them elsewhere (mgr-nx)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * A title is recorded on PC, where the whole game runs, and replayed by a small program that feeds the same packets
+ * to another renderer (mgr-nx replays them with its deko3d renderer, on Ryujinx and on the console). Enabled with
+ * --gpu_trace_path; from swap --gpu_trace_start on, --gpu_trace_frames frames are written.
+ *
+ * File: "GPUTRACE", u32 version, then records, each a u8 tag and its fields (little endian):
+ *   'R'  the register file when the recording starts: u32 count, count u32 values
+ *   'B'  a memory blob seen for the first time: u64 hash (XXH3), u32 size, the bytes (guest byte order)
+ *   'M'  GPU read of guest physical memory: u32 address, u32 size, u64 hash of a 'B' already written
+ *   'P'  one packet of the primary ring, after the 'M's it caused: u32 dword count, the dwords (guest byte order)
+ *   'S'  the end of a frame (a XE_SWAP packet was the last 'P'): u32 frame index from the start
+ *   'E'  end of the recording
+ * Replay: apply each 'M' (copy the blob to that address), execute each 'P'. A packet's reads come before it, so the
+ * memory holds what the GPU saw when it ran that packet. Indirect buffers and shader microcode are 'M's too.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::memory {
+class Memory;
+}
+
+namespace rex::graphics {
+
+class RegisterFile;
+
+// All no-ops unless a recording is running. Called from the command processor's thread.
+namespace gpu_trace {
+
+// The command processor's memory and registers, once.
+void Attach(memory::Memory* memory, const RegisterFile* registers);
+
+// A primary ring packet has been executed: its dwords are ring[start, end) (in dwords, wrapping at ring_dwords).
+void PrimaryPacket(const uint8_t* ring, uint32_t ring_dwords, uint32_t start, uint32_t end);
+
+// The GPU reads guest physical memory [address, address + size).
+void MemoryRead(uint32_t address, uint32_t size);
+
+// A XE_SWAP packet is being executed (counted from the start of the process).
+void Swap();
+
+}  // namespace gpu_trace
+
+}  // namespace rex::graphics
diff --git a/src/graphics/gpu_trace.cpp b/src/graphics/gpu_trace.cpp
new file mode 100644
index 0000000..4a43a07
--- /dev/null
+++ b/src/graphics/gpu_trace.cpp
@@ -0,0 +1,180 @@
+/**
+ * @file        graphics/gpu_trace.cpp
+ * @brief       GPU recording for replay elsewhere; see rex/graphics/gpu_trace.h (mgr-nx)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/graphics/gpu_trace.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#define XXH_INLINE_ALL
+#include <xxhash.h>
+
+#include <rex/cvar.h>
+#include <rex/graphics/register_file.h>
+#include <rex/logging.h>
+#include <rex/system/xmemory.h>
+
+REXCVAR_DEFINE_STRING(gpu_trace_path, "", "GPU",
+                      "Record GPU frames to this file for replay (rex/graphics/gpu_trace.h); empty = off");
+REXCVAR_DEFINE_INT32(gpu_trace_start, 600, "GPU", "With gpu_trace_path: first recorded frame (swaps since start)");
+REXCVAR_DEFINE_INT32(gpu_trace_frames, 3, "GPU", "With gpu_trace_path: number of frames recorded");
+
+namespace rex::graphics::gpu_trace {
+namespace {
+
+constexpr uint32_t kPhysicalSize = 0x20000000;
+
+struct Trace {
+  std::mutex lock;
+  memory::Memory* memory = nullptr;
+  const RegisterFile* registers = nullptr;
+  uint64_t swaps = 0;
+  bool recording = false;
+  bool done = false;
+  bool start_after_packet = false;  // the swap that precedes the recording is running
+  bool swap_in_packet = false;      // the packet being executed is a XE_SWAP of the recording
+  uint32_t frame = 0;
+  FILE* file = nullptr;
+  std::unordered_set<uint64_t> blobs;
+  std::vector<uint8_t> pending;  // the 'B'/'M' records of the packet being executed
+  uint64_t bytes_blobs = 0, reads = 0, packets = 0;
+};
+
+Trace& T() {
+  static Trace t;
+  return t;
+}
+
+void Put(std::vector<uint8_t>& out, const void* data, size_t size) {
+  const auto* p = static_cast<const uint8_t*>(data);
+  out.insert(out.end(), p, p + size);
+}
+template <typename V>
+void PutValue(std::vector<uint8_t>& out, V value) {
+  Put(out, &value, sizeof(value));
+}
+
+void Write(Trace& t, const std::vector<uint8_t>& data) {
+  if (t.file && !data.empty()) std::fwrite(data.data(), 1, data.size(), t.file);
+}
+
+void Start(Trace& t) {
+  const std::string path = REXCVAR_GET(gpu_trace_path);
+  t.file = std::fopen(path.c_str(), "wb");
+  if (!t.file) {
+    REXGPU_ERROR("[gpu_trace] cannot create {}", path);
+    t.done = true;
+    return;
+  }
+  std::vector<uint8_t> head;
+  Put(head, "GPUTRACE", 8);
+  PutValue<uint32_t>(head, 1);
+  PutValue<uint8_t>(head, 'R');
+  PutValue<uint32_t>(head, uint32_t(RegisterFile::kRegisterCount));
+  Put(head, t.registers->values, sizeof(t.registers->values));
+  Write(t, head);
+  t.recording = true;
+  t.frame = 0;
+  REXGPU_INFO("[gpu_trace] recording {} frames from swap {} into {}", REXCVAR_GET(gpu_trace_frames), t.swaps, path);
+}
+
+void Stop(Trace& t) {
+  std::vector<uint8_t> tail;
+  PutValue<uint8_t>(tail, 'E');
+  Write(t, tail);
+  std::fclose(t.file);
+  t.file = nullptr;
+  t.recording = false;
+  t.done = true;
+  REXGPU_INFO("[gpu_trace] done: {} frames, {} packets, {} reads, {} MB of distinct memory", t.frame, t.packets,
+              t.reads, t.bytes_blobs >> 20);
+}
+
+}  // namespace
+
+void Attach(memory::Memory* memory, const RegisterFile* registers) {
+  Trace& t = T();
+  std::lock_guard<std::mutex> guard(t.lock);
+  t.memory = memory;
+  t.registers = registers;
+}
+
+void MemoryRead(uint32_t address, uint32_t size) {
+  Trace& t = T();
+  if (!t.recording) return;
+  std::lock_guard<std::mutex> guard(t.lock);
+  if (!t.recording || !size) return;
+  address &= kPhysicalSize - 1;
+  if (address + uint64_t(size) > kPhysicalSize) size = kPhysicalSize - address;
+  const uint8_t* data = t.memory->TranslatePhysical(address);
+  const uint64_t hash = XXH3_64bits(data, size);
+  if (t.blobs.insert(hash).second) {
+    PutValue<uint8_t>(t.pending, 'B');
+    PutValue<uint64_t>(t.pending, hash);
+    PutValue<uint32_t>(t.pending, size);
+    Put(t.pending, data, size);
+    t.bytes_blobs += size;
+  }
+  PutValue<uint8_t>(t.pending, 'M');
+  PutValue<uint32_t>(t.pending, address);
+  PutValue<uint32_t>(t.pending, size);
+  PutValue<uint64_t>(t.pending, hash);
+  ++t.reads;
+}
+
+void PrimaryPacket(const uint8_t* ring, uint32_t ring_dwords, uint32_t start, uint32_t end) {
+  Trace& t = T();
+  if (!t.recording && !t.start_after_packet) return;
+  std::lock_guard<std::mutex> guard(t.lock);
+  if (t.start_after_packet) {
+    // The packet that just ran is the swap before the recording: it belongs to the previous frame.
+    t.start_after_packet = false;
+    Start(t);
+    return;
+  }
+  if (!t.recording) return;
+  const uint32_t count = (end - start) & (ring_dwords - 1);
+  PutValue<uint8_t>(t.pending, 'P');
+  PutValue<uint32_t>(t.pending, count);
+  for (uint32_t i = 0; i < count; ++i) {
+    Put(t.pending, ring + size_t((start + i) & (ring_dwords - 1)) * 4, 4);
+  }
+  ++t.packets;
+  if (t.swap_in_packet) {
+    t.swap_in_packet = false;
+    PutValue<uint8_t>(t.pending, 'S');
+    PutValue<uint32_t>(t.pending, t.frame);
+    ++t.frame;
+  }
+  Write(t, t.pending);
+  t.pending.clear();
+  if (t.frame >= uint32_t(std::max(1, REXCVAR_GET(gpu_trace_frames)))) Stop(t);
+}
+
+void Swap() {
+  Trace& t = T();
+  std::lock_guard<std::mutex> guard(t.lock);
+  ++t.swaps;
+  if (t.recording) {
+    t.swap_in_packet = true;  // marked after the packet (PrimaryPacket)
+    return;
+  }
+  if (t.done || !t.memory || !t.registers) return;
+  if (REXCVAR_GET(gpu_trace_path).empty()) {
+    t.done = true;
+    return;
+  }
+  // Starts after swap number gpu_trace_start, so the first recorded packet begins a frame.
+  if (t.swaps == uint64_t(std::max(1, REXCVAR_GET(gpu_trace_start)))) t.start_after_packet = true;
+}
+
+}  // namespace rex::graphics::gpu_trace

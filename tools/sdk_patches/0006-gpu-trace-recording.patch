+/**
+ * @file        graphics/gpu_trace.cpp
+ * @brief       GPU recording for replay elsewhere; see rex/graphics/gpu_trace.h (mgr-nx)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/graphics/gpu_trace.h>
+
+#include <algorithm>
+#include <exception>
+#include <cstdio>
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#define XXH_INLINE_ALL
+#include <xxhash.h>
+
+#include <rex/cvar.h>
+#include <rex/graphics/register_file.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+#include <rex/system/xmemory.h>
+#include <rex/ui/presenter.h>
+
+REXCVAR_DEFINE_STRING(gpu_trace_path, "", "GPU",
+                      "Record GPU frames to this file for replay (rex/graphics/gpu_trace.h); empty = off");
+REXCVAR_DEFINE_INT32(gpu_trace_start, 600, "GPU",
+                     "With gpu_trace_path: first recorded frame (swaps since start); 0 = only on request (gpu_trace_now)");
+REXCVAR_DEFINE_STRING(gpu_trace_last, "", "GPU",
+                      "Set when a recording ends: its file (the game writes <file>.shaders next to it)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_BOOL(gpu_trace_now, false, "GPU",
+                    "With gpu_trace_path: record from the next frame on (a key sets it: F9 in mgr-nx's PC build); each "
+                    "request writes <gpu_trace_path without .gtr>_<N>.gtr")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_INT32(gpu_trace_frames, 3, "GPU", "With gpu_trace_path: number of frames recorded");
+REXCVAR_DEFINE_STRING(gpu_trace_skip, "", "GPU",
+                      "With gpu_trace_path: draws of each recorded frame not executed, as \"first-last,n\" in the "
+                      "replay's numbering (draws that are not copies, from 0); to find which draw makes something");
+
+namespace rex::graphics::gpu_trace {
+namespace {
+
+constexpr uint32_t kPhysicalSize = 0x20000000;
+
+struct Trace {
+  std::mutex lock;
+  memory::Memory* memory = nullptr;
+  const RegisterFile* registers = nullptr;
+  std::function<ui::Presenter*()> presenter;
+  uint64_t swaps = 0;
+  bool recording = false;
+  bool done = false;
+  bool start_after_packet = false;  // the swap that precedes the recording is running
+  bool swap_in_packet = false;      // the packet being executed is a XE_SWAP of the recording
+  uint32_t frame = 0;
+  std::string path;       // this recording's file
+  uint32_t requests = 0;  // recordings asked for with gpu_trace_now
+  uint32_t copies = 0;  // copy draws of the frame being recorded
+  uint32_t draws = 0;   // other draws of the frame being recorded
+  FILE* file = nullptr;
+  std::unordered_set<uint64_t> blobs;
+  std::vector<uint8_t> pending;  // the 'B'/'M' records of the packet being executed
+  uint64_t bytes_blobs = 0, reads = 0, packets = 0;
+};
+
+Trace& T() {
+  static Trace t;
+  return t;
+}
+
+void Put(std::vector<uint8_t>& out, const void* data, size_t size) {
+  const auto* p = static_cast<const uint8_t*>(data);
+  out.insert(out.end(), p, p + size);
+}
+template <typename V>
+void PutValue(std::vector<uint8_t>& out, V value) {
+  Put(out, &value, sizeof(value));
+}
+
+void Write(Trace& t, const std::vector<uint8_t>& data) {
+  if (t.file && !data.empty()) std::fwrite(data.data(), 1, data.size(), t.file);
+}
+
+void Start(Trace& t) {
+  const std::string& path = t.path;
+  t.file = std::fopen(path.c_str(), "wb");
+  if (!t.file) {
+    REXGPU_ERROR("[gpu_trace] cannot create {}", path);
+    t.done = true;
+    return;
+  }
+  std::vector<uint8_t> head;
+  Put(head, "GPUTRACE", 8);
+  PutValue<uint32_t>(head, 1);
+  PutValue<uint8_t>(head, 'R');
+  PutValue<uint32_t>(head, uint32_t(RegisterFile::kRegisterCount));
+  Put(head, t.registers->values, sizeof(t.registers->values));
+  Write(t, head);
+  t.recording = true;
+  t.frame = 0;
+  t.copies = 0;
+  t.draws = 0;
+  t.blobs.clear();  // each file holds every blob it refers to
+  t.bytes_blobs = t.reads = t.packets = 0;
+  REXGPU_INFO("[gpu_trace] recording {} frames from swap {} into {}", REXCVAR_GET(gpu_trace_frames), t.swaps, path);
+}
+
+// The presented frame as a binary PPM (no image library in the SDK; tools/emu_test.sh converts and compares).
+void SaveFrame(Trace& t, uint32_t frame) {
+  ui::Presenter* presenter = t.presenter ? t.presenter() : nullptr;
+  ui::RawImage image;
+  if (!presenter || !presenter->CaptureGuestOutput(image)) {
+    REXGPU_WARN("[gpu_trace] frame {}: no image from the presenter", frame);
+    return;
+  }
+  const std::string path = t.path + ".frame" + std::to_string(frame) + ".ppm";
+  FILE* f = std::fopen(path.c_str(), "wb");
+  if (!f) return;
+  std::fprintf(f, "P6\n%u %u\n255\n", image.width, image.height);
+  for (uint32_t y = 0; y < image.height; ++y) {
+    const uint8_t* row = image.data.data() + size_t(y) * image.stride;
+    for (uint32_t x = 0; x < image.width; ++x) std::fwrite(row + x * 4, 1, 3, f);
+  }
+  std::fclose(f);
+}
+
+void Stop(Trace& t) {
+  std::vector<uint8_t> tail;
+  PutValue<uint8_t>(tail, 'E');
+  Write(t, tail);
+  std::fclose(t.file);
+  t.file = nullptr;
+  t.recording = false;
+  t.done = true;
+  rex::cvar::SetFlagByName("gpu_trace_last", t.path);
+  REXGPU_INFO("[gpu_trace] done: {} frames, {} packets, {} reads, {} MB of distinct memory", t.frame, t.packets,
+              t.reads, t.bytes_blobs >> 20);
+}
+
+}  // namespace
+
+void Attach(memory::Memory* memory, const RegisterFile* registers, std::function<ui::Presenter*()> presenter) {
+  Trace& t = T();
+  std::lock_guard<std::mutex> guard(t.lock);
+  t.memory = memory;
+  t.registers = registers;
+  t.presenter = std::move(presenter);
+}
+
+void MemoryRead(uint32_t address, uint32_t size) {
+  Trace& t = T();
+  if (!t.recording) return;
+  std::lock_guard<std::mutex> guard(t.lock);
+  if (!t.recording || !size) return;
+  address &= kPhysicalSize - 1;
+  if (address + uint64_t(size) > kPhysicalSize) size = kPhysicalSize - address;
+  const uint8_t* data = t.memory->TranslatePhysical(address);
+  const uint64_t hash = XXH3_64bits(data, size);
+  if (t.blobs.insert(hash).second) {
+    PutValue<uint8_t>(t.pending, 'B');
+    PutValue<uint64_t>(t.pending, hash);
+    PutValue<uint32_t>(t.pending, size);
+    Put(t.pending, data, size);
+    t.bytes_blobs += size;
+  }
+  PutValue<uint8_t>(t.pending, 'M');
+  PutValue<uint32_t>(t.pending, address);
+  PutValue<uint32_t>(t.pending, size);
+  PutValue<uint64_t>(t.pending, hash);
+  ++t.reads;
+}
+
+void PrimaryPacket(const uint8_t* ring, uint32_t ring_dwords, uint32_t start, uint32_t end) {
+  Trace& t = T();
+  if (!t.recording && !t.start_after_packet) return;
+  std::lock_guard<std::mutex> guard(t.lock);
+  if (t.start_after_packet) {
+    // The packet that just ran is the swap before the recording: it belongs to the previous frame.
+    t.start_after_packet = false;
+    Start(t);
+    return;
+  }
+  if (!t.recording) return;
+  const uint32_t count = (end - start) & (ring_dwords - 1);
+  PutValue<uint8_t>(t.pending, 'P');
+  PutValue<uint32_t>(t.pending, count);
+  for (uint32_t i = 0; i < count; ++i) {
+    Put(t.pending, ring + size_t((start + i) & (ring_dwords - 1)) * 4, 4);
+  }
+  ++t.packets;
+  if (t.swap_in_packet) {
+    t.swap_in_packet = false;
+    PutValue<uint8_t>(t.pending, 'S');
+    PutValue<uint32_t>(t.pending, t.frame);
+    SaveFrame(t, t.frame);
+    ++t.frame;
+    t.copies = 0;
+    t.draws = 0;
+  }
+  Write(t, t.pending);
+  t.pending.clear();
+  if (t.frame >= uint32_t(std::max(1, REXCVAR_GET(gpu_trace_frames)))) Stop(t);
+}
+
+bool Recording() { return T().recording; }
+
+// Whether draw number `draw` of the frame is in gpu_trace_skip.
+bool Skipped(uint32_t draw) {
+  const std::string list = REXCVAR_GET(gpu_trace_skip);
+  size_t start = 0;
+  while (start < list.size()) {
+    const size_t end = std::min(list.find(',', start), list.size());
+    const std::string item = list.substr(start, end - start);
+    const size_t dash = item.find('-');
+    try {
+      const uint32_t first = uint32_t(std::stoul(item.substr(0, dash)));
+      const uint32_t last = dash == std::string::npos ? first : uint32_t(std::stoul(item.substr(dash + 1)));
+      if (draw >= first && draw <= last) return true;
+    } catch (const std::exception&) {
+    }
+    start = end + 1;
+  }
+  return false;
+}
+
+bool Draw() {
+  Trace& t = T();
+  if (!t.recording) return false;
+  const RegisterFile& r = *t.registers;
+  if ((r[XE_GPU_REG_RB_MODECONTROL] & 0x7) == uint32_t(xenos::EdramMode::kCopy)) {
+    ++t.copies;  // before the copy runs (Resolved): numbered from 1, the replay's steps from 0
+  } else {
+    const bool skip = Skipped(t.draws++);
+    // The index buffer: the primitive processor only reads it when its converted copy is not cached.
+    const uint32_t initiator = r[XE_GPU_REG_VGT_DRAW_INITIATOR];
+    if (((initiator >> 6) & 0x3) == uint32_t(xenos::SourceSelect::kDMA)) {
+      const uint32_t size_log2 = (initiator >> 11) & 0x1 ? 2 : 1;
+      MemoryRead(r[XE_GPU_REG_VGT_DMA_BASE] & ~((1u << size_log2) - 1), (initiator >> 16) << size_log2);
+    }
+    return skip;
+  }
+  const uint32_t fetch0 = r[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0];
+  const uint32_t fetch1 = r[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_1];
+  if ((fetch0 & 0x3) != uint32_t(xenos::FetchConstantType::kVertex)) return false;
+  MemoryRead(fetch0 & ~uint32_t(0x3), ((fetch1 >> 2) & 0xFFFFFF) * 4);
+  return false;
+}
+
+void Resolved(uint32_t address, uint32_t length) {
+  Trace& t = T();
+  if (!t.recording || !length) return;
+  std::lock_guard<std::mutex> guard(t.lock);
+  const std::string folder = t.path + ".res";
+  std::error_code error;
+  std::filesystem::create_directories(folder, error);
+  const std::string name = "f" + std::to_string(t.frame) + "_s" + std::to_string(t.copies) + ".bin";
+  if (FILE* f = std::fopen((folder + "/" + name).c_str(), "wb")) {
+    std::fwrite(t.memory->TranslatePhysical(address), 1, length, f);
+    std::fclose(f);
+  }
+  if (FILE* f = std::fopen((folder + "/index.txt").c_str(), "a")) {
+    const RegisterFile& r = *t.registers;
+    std::fprintf(f, "%u %u %08X %X %08X %08X %08X %08X\n", t.frame, t.copies, address, length,
+                 r[XE_GPU_REG_RB_COPY_DEST_BASE], r[XE_GPU_REG_RB_COPY_DEST_PITCH], r[XE_GPU_REG_RB_COPY_DEST_INFO],
+                 r[XE_GPU_REG_RB_COPY_CONTROL]);
+    std::fclose(f);
+  }
+}
+
+void Swap() {
+  Trace& t = T();
+  std::lock_guard<std::mutex> guard(t.lock);
+  ++t.swaps;
+  if (t.recording) {
+    t.swap_in_packet = true;  // marked after the packet (PrimaryPacket)
+    return;
+  }
+  if (!t.memory || !t.registers || t.start_after_packet) return;
+  const std::string base = REXCVAR_GET(gpu_trace_path);
+  if (base.empty()) return;
+  // Starts after this swap, so the first recorded packet begins a frame: at swap gpu_trace_start, or when asked.
+  if (REXCVAR_GET(gpu_trace_now)) {
+    rex::cvar::SetFlagByName("gpu_trace_now", "false");
+    const std::string stem = base.size() > 4 && base.compare(base.size() - 4, 4, ".gtr") == 0
+                                 ? base.substr(0, base.size() - 4)
+                                 : base;
+    t.path = stem + "_" + std::to_string(++t.requests) + ".gtr";
+    t.start_after_packet = true;
+  } else if (!t.done && REXCVAR_GET(gpu_trace_start) > 0 && t.swaps == uint64_t(REXCVAR_GET(gpu_trace_start))) {
+    t.path = base;
+    t.start_after_packet = true;
+  }
+}
+
+}  // namespace rex::graphics::gpu_trace

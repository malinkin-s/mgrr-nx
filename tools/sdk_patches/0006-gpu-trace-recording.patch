+/**
+ * @file        rex/graphics/gpu_trace.h
+ * @brief       Records what the GPU executed for a few frames, to replay them elsewhere (mgr-nx)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * A title is recorded on PC, where the whole game runs, and replayed by a small program that feeds the same packets
+ * to another renderer (mgr-nx replays them with its deko3d renderer, on Ryujinx and on the console). Enabled with
+ * --gpu_trace_path; from swap --gpu_trace_start on, --gpu_trace_frames frames are written.
+ *
+ * File: "GPUTRACE", u32 version, then records, each a u8 tag and its fields (little endian):
+ *   'R'  the register file when the recording starts: u32 count, count u32 values
+ *   'B'  a memory blob seen for the first time: u64 hash (XXH3), u32 size, the bytes (guest byte order)
+ *   'M'  GPU read of guest physical memory: u32 address, u32 size, u64 hash of a 'B' already written
+ *   'P'  one packet of the primary ring, after the 'M's it caused: u32 dword count, the dwords (guest byte order)
+ *   'S'  the end of a frame (a XE_SWAP packet was the last 'P'): u32 frame index from the start
+ *   'E'  end of the recording
+ * Next to it, <FILE>.frame<N>.ppm is the image this renderer presented at the end of recorded frame N.
+ * Replay: apply each 'M' (copy the blob to that address), execute each 'P'. A packet's reads come before it, so the
+ * memory holds what the GPU saw when it ran that packet. Indirect buffers and shader microcode are 'M's too.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+
+namespace rex::memory {
+class Memory;
+}
+namespace rex::ui {
+class Presenter;
+}
+
+namespace rex::graphics {
+
+class RegisterFile;
+
+// All no-ops unless a recording is running. Called from the command processor's thread.
+namespace gpu_trace {
+
+// The command processor's memory, registers and presenter, once. After each recorded frame the presenter's output is
+// saved as <gpu_trace_path>.frame<N>.ppm: what this renderer showed, the reference for the replay.
+void Attach(memory::Memory* memory, const RegisterFile* registers, std::function<ui::Presenter*()> presenter);
+
+// A primary ring packet has been executed: its dwords are ring[start, end) (in dwords, wrapping at ring_dwords).
+void PrimaryPacket(const uint8_t* ring, uint32_t ring_dwords, uint32_t start, uint32_t end);
+
+// The GPU reads guest physical memory [address, address + size).
+void MemoryRead(uint32_t address, uint32_t size);
+
+// A recording is running (for hooks that cost something to compute).
+bool Recording();
+
+// A draw has been issued. Its index buffer is recorded (the primitive processor reads it only when its converted copy
+// is not cached); in copy mode, the vertices of fetch constant 0 instead: a resolve takes its rectangle from them,
+// which this GPU emulation never reads (it uses the scissor) but a native renderer does.
+// true: do not execute it (gpu_trace_skip, to find which draw makes something in the recorded frames).
+bool Draw();
+
+// A resolve wrote guest memory [address, address + length) (only with --readback_resolve=full, which the
+// recording then needs for these). Saved as <gpu_trace_path>.res/f<frame>_s<copy>.bin with a line in index.txt
+// ("frame copy address length dest_base dest_pitch dest_info copy_control", hex): the reference of each step of the
+// replay's step mode, which numbers the copy draws of a frame the same way.
+void Resolved(uint32_t address, uint32_t length);
+
+// A XE_SWAP packet is being executed (counted from the start of the process).
+void Swap();
+
+}  // namespace gpu_trace
+
+}  // namespace rex::graphics

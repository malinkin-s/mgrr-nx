-Handle Proc() { return envGetOwnProcessHandle(); }
+// hbloader hands the process its own handle: the kernel's process-memory SVCs (svcMapProcessCodeMemory...) want a
+// real one, not the CUR_PROCESS_HANDLE pseudo-handle. A loader that does not, Ryujinx with homebrew (mgr-nx,
+// tools/emu_test.sh), leaves INVALID_HANDLE; the handle is then made the way hbloader makes its own: the pseudo-handle
+// sent as a copy handle over a session to ourselves, which the kernel turns into a real handle on the way.
+void ReceiveOwnHandle(void* arg) {
+    Handle* io = static_cast<Handle*>(arg);  // in: the server session; out: the handle received
+    const Handle session = *io;
+    *io = INVALID_HANDLE;
+    void* tls = armGetTls();
+    hipcMakeRequestInline(tls);
+    s32 index = 0;
+    if (R_SUCCEEDED(svcReplyAndReceive(&index, &session, 1, INVALID_HANDLE, UINT64_MAX))) {
+        const HipcParsedRequest request = hipcParseRequest(tls);
+        if (request.meta.num_copy_handles == 1) {
+            *io = request.data.copy_handles[0];
+        }
+    }
+    svcCloseHandle(session);
+}
+
+Handle MakeOwnHandle() {
+    Handle server = INVALID_HANDLE, client = INVALID_HANDLE;
+    if (R_FAILED(svcCreateSession(&server, &client, 0, 0))) {
+        return INVALID_HANDLE;
+    }
+    Handle io = server;
+    Thread thread;
+    if (R_FAILED(threadCreate(&thread, ReceiveOwnHandle, &io, nullptr, 0x1000, 0x2C, -2))) {
+        svcCloseHandle(server);
+        svcCloseHandle(client);
+        return INVALID_HANDLE;
+    }
+    threadStart(&thread);
+    hipcMakeRequestInline(armGetTls(), .num_copy_handles = 1).copy_handles[0] = CUR_PROCESS_HANDLE;
+    svcSendSyncRequest(client);
+    svcCloseHandle(client);
+    threadWaitForExit(&thread);
+    threadClose(&thread);
+    return io;
+}
+
+Handle Proc() {
+    static const Handle handle = [] {
+        const Handle h = envGetOwnProcessHandle();
+        return h != INVALID_HANDLE ? h : MakeOwnHandle();
+    }();
+    return handle;
+}
 

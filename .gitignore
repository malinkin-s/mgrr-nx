# Whitelist. Only this project's own sources, configs and docs are tracked.
# NEVER commit game data: extracted ISO/OBB/APK, decrypted images, recompiled C++ (ppc*/),
# extracted or translated shaders, textures, models, renders of game assets, build outputs.
/*
!/.gitignore
!/.gitmodules
!/LICENSE
!/README.md
!/README_RU.md
!/PLAN.md
!/NOTES.md
!/tools/
!/docs/
!/game/
!/sdk

# analysis results that contain only addresses, names and our own notes
!/x360_work/
/x360_work/*
!/x360_work/*.md
!/x360_work/*.toml
!/x360_work/runtime_imports.txt
!/x360_work/rexglue_extra_functions.txt
!/x360_work/rexglue_inner_entries.txt
!/x360_work/d3d_entrypoints.json
!/x360_work/d3d_setters.json
!/x360_work/sampler_setters.json
!/x360_work/x360_vertex_decls.json

# Inside the tracked folders too: build outputs and anything derived from the game.
__pycache__/
*.pyc
*.o
*.obj
*.a
*.so
*.elf
*.nro
*.nacp
*.nso
*.nsp
*.log
# game files and what is made from them
*.xex
*.iso
*.cpk
*.dat
*.usm
*.wmb
*.wtb
*.vso
*.pso
*.hlsl
*.spv
*.dksh
*.mgsl
*.xsh
*.ppm
# console keys and saves
*.keys
*.bin
# editors and OS
.vscode/
.idea/
.DS_Store
*.swp

# generated by the ReXGlue codegen from the user's own game files
/game/generated/
